# Root example for reference only. The backend reads backend/.env (copy backend/.env.example),
# the frontend reads frontend/.env.local (copy frontend/.env.example).

# --- backend/.env ---
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_PUBLIC_URL=wss://socket-ind-pub.testnet.deltaex.org
DELTA_WS_PRIVATE_URL=wss://socket-ind.testnet.deltaex.org

# PRESET=validated -> trend_regime on 1h (the backtested setting)
# PRESET=demo      -> trend_regime on 1m with faster entries, so judges see trades (labelled "demo speed")
PRESET=validated
DRY_RUN=true          # false = real orders on Delta TESTNET
AUTO_START=false
SYMBOL=BTCUSD

RISK_PER_TRADE_PCT=1.0
MAX_LEVERAGE=5
DAILY_LOSS_LIMIT_PCT=3.0
MAX_TRADES_PER_DAY=10
COOLDOWN_MINUTES_AFTER_LOSS=15

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000
